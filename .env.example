# ==========================================================================
# ШАБЛОН ЛОКАЛЬНОГО ФАЙЛУ .env
#
# Як користуватися (детально — docs/SETUP.md, крок 2):
#   1. Скопіюйте цей файл:   cp .env.example .env
#      (Windows PowerShell:  Copy-Item .env.example .env)
#   2. Заповніть значення в .env (НЕ в цьому файлі).
#   3. Ніколи не комітьте .env і не вставляйте його вміст у чат/Issue.
#      Файл .env уже є в .gitignore, тож Git його ігнорує.
#
# Цей файл-шаблон порожній навмисно і безпечний для GitHub.
# ==========================================================================

# --- PythonAnywhere ---------------------------------------------------------
# Ваш логін на PythonAnywhere (наприклад: csctemplate).
PA_USERNAME=

# API-токен: PythonAnywhere → вкладка «Account» → розділ «API token».
# Це НЕ пароль від сайту. Токен дає доступ до файлів і веб-апки, тож тримайте його в секреті.
PA_API_TOKEN=

# Адреса сайту. Якщо порожньо — береться <PA_USERNAME>.pythonanywhere.com.
PA_DOMAIN=

# --- OpenAI (необов'язково) -------------------------------------------------
# Без ключа сайт працює в режимі «лише джерела»: показує фрагменти уроку.
# З ключем — відповідь формує модель, спираючись лише на ці фрагменти.
# ВАЖЛИВО: на безплатному PythonAnywhere зовнішній доступ до OpenAI може
# бути заблокований; тоді сайт автоматично покаже джерела без відповіді моделі.
OPENAI_API_KEY=

# Модель за замовчуванням. Змініть, якщо ваш проєкт OpenAI має доступ до іншої.
OPENAI_MODEL=gpt-4.1-mini

# --- Необов'язкові налаштування пошуку ---------------------------------------
# Скільки фрагментів уроку показувати/передавати моделі (1–10).
RAG_TOP_K=4

# 0 — вимкнути виклик моделі навіть за наявності ключа (корисно для тестів).
RAG_USE_LLM=1
